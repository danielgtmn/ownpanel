[Unit]
Description=Caddy web server (managed by ownpanel)
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/ownpanel/caddy-home
Environment=XDG_CONFIG_HOME=/var/lib/ownpanel/caddy-home
# The admin API is a Unix socket, never a TCP port: on TCP every local user
# could rewrite the web server's config.
# Access: systemd creates /run/ownpanel as caddy:caddy with mode 0750, and Caddy
# creates the socket in it with mode 0660, owned by its primary group caddy.
# The user ownpanel is a member of the group caddy (install.sh), so ownpaneld can
# connect; other local users can neither enter the directory nor open the
# socket. Caddy's own data directories are 0700, so the group membership
# grants ownpanel nothing else.
RuntimeDirectory=ownpanel
RuntimeDirectoryMode=0750
# The bootstrap file only sets the admin socket; ownpaneld pushes the full
# config. --resume brings the last pushed config back right after a restart.
ExecStart=/usr/local/bin/caddy run --config /etc/ownpanel/caddy-bootstrap.json --resume
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
