[Unit]
Description=ownpanel daemon
# Start after Caddy, which counts as started once its admin socket exists.
# Wants=, not Requires=: the panel must still start (and show what is wrong)
# when Caddy fails, and it brings Caddy's config back by itself once Caddy runs.
After=network-online.target ownpanel-caddy.service ownpanel-mail.service
Wants=network-online.target ownpanel-caddy.service

[Service]
User=ownpanel
Group=ownpanel
# OWNPANELD_ARGS (install.sh writes the default):
#   -tls acme -caddy-admin unix:///run/ownpanel/caddy-admin.sock
# Add -panel-domain panel.example.com to reach the panel over HTTPS.
EnvironmentFile=-/etc/ownpanel/ownpaneld.env
ExecStart=/usr/local/bin/ownpaneld -data /var/lib/ownpanel $OWNPANELD_ARGS
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
