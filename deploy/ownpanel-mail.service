[Unit]
Description=ownpanel mail service
After=network-online.target
Wants=network-online.target

[Service]
User=ownpanel-mail
Group=ownpanel-mail
# The mail service parses mail from the whole Internet, so it runs as its own
# user with its own data: it cannot read the panel's database or secret.key,
# and the panel cannot read stored mail.
# Admin socket: systemd creates /run/ownpanel-mail as ownpanel-mail with mode
# 0750, the service creates admin.sock in it with mode 0660. The user ownpanel
# is a member of the group ownpanel-mail (install.sh), so ownpaneld can push
# the configuration; other local users cannot reach the socket.
# Web socket: systemd creates /run/ownpanel-mail-web the same way; the service
# (a member of the group ownpanel-mail-web) hands it and web.sock to that group
# (-web-group). Only Caddy's user is a member: Caddy passes the mail host's
# account pages, calendars and contacts to web.sock and cannot reach admin.sock.
RuntimeDirectory=ownpanel-mail ownpanel-mail-web
RuntimeDirectoryMode=0750
SupplementaryGroups=ownpanel-mail-web
StateDirectory=ownpanel-mail
StateDirectoryMode=0700
UMask=0077
# The last configuration the panel pushed is in /var/lib/ownpanel-mail, so
# mail keeps working while the panel is stopped or updated.
ExecStart=/usr/local/bin/ownpaneld mail -data /var/lib/ownpanel-mail -admin /run/ownpanel-mail/admin.sock -web unix:///run/ownpanel-mail-web/web.sock -web-group ownpanel-mail-web
Restart=on-failure
# Running SMTP transactions get time to finish on stop.
TimeoutStopSec=45
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65536
# Defence in depth: one process serves mail for every mailbox, so a bug
# that makes it grow must not take the whole server with it. Normal use is
# a few hundred MB at most; the Go runtime collects harder near its soft
# limit (GOMEMLIMIT), the kernel reclaims above MemoryHigh and kills the
# service (which restarts) above MemoryMax. Threads, not connections, count
# as tasks; Go needs few.
Environment=GOMEMLIMIT=1280MiB
MemoryHigh=1536M
MemoryMax=2G
TasksMax=1024
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
